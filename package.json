{
  "name": "stockfolio",
  "version": "2.2.0",
  "private": true,
  "description": "Stockfolio — local-first portfolio manager by Richard Najem",
  "author": "Richard Najem <richard2.najem@gmail.com>",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "dev:electron": "cross-env BROWSER=none NEXT_DEV_PORT=3457 concurrently --kill-others --success command-electron -n electron,next \"electron .\" \"next dev -p 3457\"",
    "build": "next build",
    "build:electron": "npm run build && node scripts/depsymlinks.cjs && electron-builder",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "update:app": "node scripts/update-app.js",
    "test:updates": "node scripts/test-updates.js",
    "test:update-button": "node tests/electron/verify-update-button.cjs",
    "electron": "electron .",
    "pack": "npm run build && node scripts/depsymlinks.cjs && electron-builder --dir",
    "dist": "npm run build && node scripts/depsymlinks.cjs && electron-builder",
    "release": "npm run build && node scripts/depsymlinks.cjs && electron-builder --publish always"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.3.9",
    "jose": "^6.2.12",
    "next": "16.3.5",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.stockfolio.app",
    "productName": "Stockfolio",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/better-sqlite3/**",
      "**/node_modules/@next/swc-*/**"
    ],
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      ".next/**/*",
      "!.next/dev/**",
      "!.next/cache/**",
      "public/**/*",
      "package.json",
      "!node_modules/sharp/**",
      "!node_modules/@img/**",
      "!node_modules/better-sqlite3/**",
      "!node_modules/pdf-parse/**",
      "!node_modules/xlsx/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Stockfolio-Portable-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "Richardnajem",
      "repo": "ACCUBOOK"
    }
  }
}
